# Copy to .env (never commit it). One provider is enough; with both set, a failed call falls back to the other.
OPENAI_API_KEY=
OPENAI_DECISION_MODEL=gpt-6-luna
OPENAI_BUDGET_USD=2.50
# Cloudflare Workers AI ("Clef")
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
